    "feedback.mailUnavailable.message %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav si na zařízení Mail, nebo si report zkopíruj a pošli na %@. Přílohy zkopírovat nejdou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte Mail auf diesem Gerät ein oder kopiere den Bericht und schicke ihn selbst an %@. Anhänge lassen sich nicht kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up Mail on this device, or copy the report and send it to %@ yourself. Attachments can't be copied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura Mail en este dispositivo, o copia el informe y envíalo tú a %@. Los adjuntos no se pueden copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure Mail sur cet appareil, ou copie le rapport et envoie-le toi-même à %@. Les pièces jointes ne peuvent pas être copiées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure o Mail neste dispositivo, ou copie o relatório e envie você mesmo para %@. Os anexos não podem ser copiados."
          }
        }
      }
    },
