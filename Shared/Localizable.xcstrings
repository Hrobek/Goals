    "firstRun.subtitle" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goals hlídá jedinou věc: co sis předsevzal a jestli jsi to dnes udělal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goals behält eine Sache im Blick: was du dir vorgenommen hast — und ob du es heute getan hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goals keeps one thing in view: what you said you'd do, and whether you did it today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goals mantiene una cosa a la vista: lo que dijiste que harías, y si lo hiciste hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goals garde une chose en vue : ce que tu as dit que tu ferais, et si tu l’as fait aujourd’hui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Goals mantém uma coisa à vista: o que você disse que faria, e se fez isso hoje."
          }
        }
      }
    },
