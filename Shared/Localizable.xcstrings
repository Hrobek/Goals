    "reminder.permission.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomínky potřebují povolení notifikací. Zapneš ho v Nastavení iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen brauchen die Erlaubnis für Mitteilungen. Du kannst sie in den iOS-Einstellungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders need notification permission. You can turn it on in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios necesitan permiso de notificaciones. Puedes activarlo en los Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels nécessitent l’autorisation des notifications. Tu peux l’activer dans les Réglages iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes precisam de permissão de notificações. Você pode ativar nos Ajustes do iOS."
          }
        }
      }
