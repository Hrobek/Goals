    "goalDetail.chart.locked" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvidíš svůj postup jedním pohledem – jak roste, kde se zadrhl a jak blízko jsi cíli."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deinen Fortschritt auf einen Blick — wo es vorangeht, wo es stockt und wie nah du deinem Ziel bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your progress at a glance — where it's climbing, where it stalled, and how close you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira tu progreso de un vistazo — dónde avanza, dónde se estancó y qué tan cerca estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois ta progression en un coup d’œil — où ça avance, où ça stagne, et à quel point tu es proche du but."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja seu progresso em um relance — onde está subindo, onde estagnou e o quão perto você está."
          }
        }
      }
    },
