    "feedback.diagnostics.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odešle se se zprávou, aby šla chyba zreprodukovat. Nic z tvých cílů ani účtu se neposílá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird mit deiner Nachricht gesendet, damit sich das Problem nachstellen lässt. Nichts aus deinen Zielen oder deinem Konto ist dabei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent along with your message so the issue can be reproduced. Nothing from your goals or account is included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía con tu mensaje para poder reproducir el problema. No se incluye nada de tus objetivos ni de tu cuenta."
