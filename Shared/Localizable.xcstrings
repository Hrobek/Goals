    "firstRun.point.goal.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číslo, kterého chceš dosáhnout, nebo seznam podúkolů — a jak často na tom chceš dělat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zahl, die du erreichen willst, oder eine Liste von Teilaufgaben — und wie oft du daran arbeiten willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A number to reach or a list of subtasks — plus how often you want to work on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un número que alcanzar o una lista de subtareas — y con qué frecuencia quieres trabajar en ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
