          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado junto com sua mensagem para o problema poder ser reproduzido. Nada dos seus objetivos ou da sua conta é incluído."
          }
        }
      }
    },
