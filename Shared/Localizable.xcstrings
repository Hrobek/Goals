    "pace.locked" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekneme ti přesně, co dělat, abys stihl termín – nebo kam tě dovede tvoje současné tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen dir genau, was zu tun ist, um deine Frist zu halten – oder wohin dich dein aktuelles Tempo bringt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll tell you exactly what to do to hit your deadline — or where your current pace is taking you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te diremos exactamente qué hacer para llegar a tu fecha límite, o adónde te lleva tu ritmo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te dira exactement quoi faire pour tenir ton échéance — ou où ton rythme actuel te mène."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diremos exatamente o que fazer para cumprir seu prazo — ou aonde seu ritmo atual está te levando."
          }
        }
      }
    },
