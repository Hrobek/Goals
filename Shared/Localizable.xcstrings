    "reminder.inactivity.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chvíli jsme se neviděli. Stačí jeden check-in a série žije dál."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst länger nicht da. Ein kurzes Abhaken hält die Serie am Leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's been a while. One quick check-in keeps the streak alive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace tiempo que no te vemos. Basta con marcar una vez para mantener la racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça fait un moment. Un simple pointage suffit à garder la série."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz um tempo. Uma marcação rápida mantém a sequência viva."
          }
        }
      }
    },
    "reminder.inactivity.title" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
