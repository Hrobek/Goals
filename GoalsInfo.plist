<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance, answered once here so App Store Connect stops asking on every upload.
	     False is the honest answer: the app does no cryptography of its own - just HTTPS and the
	     standard OS services (CloudKit, the analytics upload). Revisit if the app ever encrypts
	     data itself. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- CloudKit (SwiftData sync): 'remote-notification' delivers change pushes, 'processing'
	     lets NSPersistentCloudKitContainer run its scheduled export/import in the background.
	     Without the permitted-identifier below it logs "BGSystemTaskSchedulerErrorDomain Code=3". -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.apple.coredata.cloudkit.activity</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hrobek.goals</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>goals</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
